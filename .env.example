# Copy this file to .env.local and fill it in. Never commit .env.local.
# Where to find these: Supabase dashboard -> Project Settings -> API (or "API Keys").

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# SERVER ONLY. Bypasses row-level security. Used for exactly two things:
# creating a login when staff are added, and the one-off owner bootstrap script.
# Never prefix with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# SERVER ONLY, and only for `npm run db:apply` on your own machine. Supabase dashboard -> Connect -> Session pooler.
# Replace [YOUR-PASSWORD] with the database password. Never add this to Vercel.
SUPABASE_DB_URL=

# Local design preview only. With Supabase NOT configured, `npm run dev` signs you in as a demo Owner so the dashboard
# screens can be worked on. It is ignored in production builds. Delete this line once Supabase is connected.
# DREZZY_DEMO_STAFF=1

# ---- Payments (sprint 3/4) ----
# Paystack secret key (Settings -> API Keys & Webhooks). Leave empty until Paystack approves your account: checkout then
# offers manual MoMo only. SERVER ONLY.
PAYSTACK_SECRET_KEY=
# In the Paystack dashboard set the webhook URL to:  https://YOUR-DOMAIN/api/payments/paystack/webhook
#
# Manual MoMo fallback (PRD FR-CO-006): customers pay to this number, then enter the transaction ID.
DREZZY_MOMO_NUMBER=
DREZZY_MOMO_NAME=
# Public address of the site, used for the card payment return link. Optional on Vercel.
NEXT_PUBLIC_SITE_URL=

# ---- Customer emails ----
# Order confirmations and status updates are queued by the database and sent by a job that runs every 5 minutes.
# Create a free account at resend.com, verify your sending domain, and paste the key. Leave empty to keep emails queued.
RESEND_API_KEY=
NOTIFY_FROM="Drezzy Stores <orders@yourdomain.com>"
# Any long random string. Vercel Cron sends it so only the schedule can run the sender.
CRON_SECRET=

# ---- Texts and WhatsApp (optional; switch on when the accounts exist) ----
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMS_FROM=Drezzy
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en

# ---- Sign-in options (set to 1 once the provider is set up in Supabase Authentication) ----
NEXT_PUBLIC_GOOGLE_AUTH=
NEXT_PUBLIC_PHONE_OTP=

# ---- Ad and analytics tags (optional; they load only for visitors who accept analytics) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
